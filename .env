# Database credentials and configuration
RESOURCE_DB_NAME=resource_db
RESOURCE_DB_USER=postgres
RESOURCE_DB_PASSWORD=postgres
RESOURCE_DB_PORT=5433
RESOURCE_DB_URL=jdbc:postgresql://resource-db:5432/resource_db

SONG_DB_NAME=song_db
SONG_DB_USER=postgres
SONG_DB_PASSWORD=postgres
SONG_DB_PORT=5434
SONG_DB_URL=jdbc:postgresql://song-db:5432/song_db

# Microservices configuration
RESOURCE_SERVICE_PORT=8084
SONG_SERVICE_PORT=8085-8086
SONG_SERVICE_URL=http://song-service
EUREKA_SERVER_PORT=8761

EUREKA_CLIENT_SERVICE_URL_DEFAULT_ZONE=http://music-service-registry:8761/eureka/

# Cloud Storage configuration (LocalStack S3)
LOCALSTACK_PORT=4566
AWS_S3_ENDPOINT=http://localstack:4566
AWS_S3_BUCKET=resources
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
